# Backend Environment Variables
# Copy this file to .env and fill in values for local development.

# Database URL
# For local development, SQLite is used by default.
# For production (Render), this is set automatically from the PostgreSQL service.
# DATABASE_URL=sqlite:///./lost_found.db

# CORS — comma-separated list of allowed origins
# For local development, the defaults work.
# For production, set this to your deployed frontend URL.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Port (Render sets this automatically)
# PORT=8000
